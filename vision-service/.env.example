SERVICE_NAME=vision-service
SERVICE_VERSION=0.1.0
SERVICE_PORT=8001
REDIS_URL=redis://redis:6379/0
CACHE_DIR=cache
JOB_TTL_SECONDS=86400
WS_POLL_INTERVAL_SECONDS=1.0

CRS_DEFAULT=EPSG:4326
DATASET_CACHE_TTL_SECONDS=86400
PROVIDER_MAX_RETRIES=3
PROVIDER_BACKOFF_BASE_SECONDS=1

DATA_DIR=data
IMG_SIZE=512
TILE_SIZE=512
TILE_OVERLAP=64
MASK_THRESHOLD=0.5
MIN_BRANCH_LEN_PX=15
SIMPLIFY_TOLERANCE_PX=1.5

WEIGHTS_DIR=weights
MODEL_CHECKPOINT=weights/roadnet.pt
ENCODER_NAME=resnet34
DEFAULT_MODEL=segformer
SEGFORMER_CHECKPOINT=weights/segformer
DEEPLABV3PLUS_CHECKPOINT=weights/deeplabv3plus.pt

SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_TOKEN_URL=https://services.sentinel-hub.com/oauth/token
SENTINEL_PROCESS_URL=https://services.sentinel-hub.com/api/v1/process
SENTINEL_COLLECTION=sentinel-2-l2a
SENTINEL_OUTPUT_SIZE=512
SPACENET_S3_BUCKET=spacenet-dataset
SPACENET_SAMPLE_TIF_URL=
